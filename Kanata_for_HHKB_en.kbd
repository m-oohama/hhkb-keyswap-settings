#|
Kanata Keyboard Layout for Happy Hacking Keyboard (HHKB)
Emulates US layout behavior on Windows with JIS layout settings
|#

(defcfg
  process-unmapped-keys yes ;; Process keys that are not explicitly mapped
)

(defalias
  eq (unicode "=")    ;; = EQUALS SIGN
  ap (unicode "'")    ;; ' APOSTROPHE
  ga (unicode "`")    ;; ` GRAVE ACCENT
  at (unicode "@")    ;; @ COMMERCIAL AT
  ca (unicode "^")    ;; ^ CARET
  am (unicode "&")    ;; & AMPERSAND
  as (unicode "*")    ;; * ASTERISK
  lp (unicode "(")    ;; ( LEFT PARENTHESIS
  rp (unicode ")")    ;; ) RIGHT PARENTHESIS
  ll (unicode "_")    ;; _ LOW LINE
  cl (unicode ":")    ;; : COLON
  dq (unicode r#"""#) ;; " DOUBLE QUOTE
  ti (unicode "~")    ;; ~ TILDE
  ;;al (tap-dance 200 (_ M-C-0 M-A-0 M-S-0)) ;; Alt when held, Meta with Alt 0 when tapped
  ;;al (multi alt (tap-dance 200 (M-C-0 M-A-0 M-S-0))) ;; Alt when held, Meta with Alt 0 when tapped
  al (tap-hold 100 100 (tap-dance 200 (M-C-0 M-A-0 M-S-0)) alt) ;; Alt when held, Meta with Alt 0 when tapped
  ls (multi (chord Win-Shift lsft) (layer-while-held US-Shift)) ;; Left Shift + US Shift Layer
  me (multi (chord Win-Shift lmet) (layer-while-held US-Win)) ;; Left Meta + US Win + Shift Layer
)

;; Happy Hacking Keyboard JIS layout
(defsrc
  esc       1         2         3         4         5         6         7         8         9         0         Minus     Quote     \         Backspace
  tab       q         w         e         r         t         y         u         i         o         p         grv       [                   Enter
  lctl      a         s         d         f         g         h         j         k         l         Equal     scln      F19
  lsft      z         x         c         v         b         n         m         ,         .         /         nubs      ]                   rsft
  lalt                lmet
)
(defchords Win-Shift 1000
  (lmet lsft) (multi lmet lsft (layer-while-held US-Win-Shift))
)
;; Base Layer
(deflayer US-Base
  _         _         _         _         _         _         _         _         _         _         _         _         @eq       _         _
  _         _         _         _         _         _         _         _         _         _         _         [         ]                   _
  _         _         _         _         _         _         _         _         _         _         _         @ap       @ga
  @ls       _         _         _         _         _         _         _         _         _         _         _         _                   _
  @al                 @me
)
;; Shift Layer
(deflayer US-Shift
  _         _         @at       _         _         _         @ca       @am       @as      @lp        @rp       @ll       +         _         (unshift Delete)
  _         _         _         _         _         _         _         _         _         _         _         [         ]                   _
  _         _         _         _         _         _         _         _         _         _         @cl       @dq       @ti
  _         _         _         _         _         _         _         _         _         _         _         _         _                   _
  _                   _
)
(deflayer US-Win
  _         _         _         _         _         _         _         _         _         _         _         _         @eq       _         _
  _         _         _         _         _         _         _         _         _         _         _         [         ]                   _
  _         _         _         _         _         _         _         _         _         _         _         @ap       @ga
  _         _         _         _         _         _         _         _         _         _         _         _         _                   _
  _                   _
)
;; Windows Key + Shift Layer
(deflayer US-Win-Shift
  _         _         _         _         _         _         _         _         _         _         _         _         @eq       _         _
  _         _         _         _         _         _         _         _         _         _         _         [         ]                   _
  _         _         _         _         _         _         _         _         _         _         _         @ap       @ga
  _         _         _         _         _         _         _         _         _         _         _         _         _                   _
  _                   _
)